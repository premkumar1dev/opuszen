{
  "framework": "react-router",
  "redirects": [
    {
      "source": "/admin",
      "destination": "/auth/admin",
      "permanent": true
    },
    {
      "source": "/auyh/admin",
      "destination": "/auth/admin",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/chat/completions",
      "destination": "/api/chat/completions"
    },
    {
      "source": "/v1/chat/completions",
      "destination": "/api/chat/completions"
    },
    {
      "source": "/v1/messages",
      "destination": "/api/chat/completions"
    },
    {
      "source": "/v1/models",
      "destination": "/api/chat/completions"
    },
    {
      "source": "/v1/(.*)",
      "destination": "/api/chat/completions"
    },
    {
      "source": "/api/v1/chat/completions",
      "destination": "/api/chat/completions"
    },
    {
      "source": "/api/v1/messages",
      "destination": "/api/chat/completions"
    },
    {
      "source": "/api/v1/models",
      "destination": "/api/chat/completions"
    },
    {
      "source": "/api/v1/(.*)",
      "destination": "/api/chat/completions"
    }
  ]
}